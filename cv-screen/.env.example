# Copy to .env and paste your key here.
# Get it from https://console.typesafe.ai/settings/keys  (starts with ts_ or similar)
#
# .env is gitignored. Never commit it, never paste the key into a workflow JSON.
TYPESAFE_API_KEY=

# ------------------------------------------------------------------
# Security settings (strongly recommended before any network exposure)
# ------------------------------------------------------------------

# Shared secret for all mutating/PII API routes.
# The browser UI reads this from localStorage (prompted once on first load).
# Without this set, all routes are accessible from loopback without a token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CV_SCREEN_API_TOKEN=

# Folder that /api/batch/scan is allowed to read.
# Paths outside this directory are rejected even if they exist on disk.
# Defaults to the project root (so bench/smoke scripts work out of the box).
# In production narrow this to the actual CV folder:
# SCAN_ROOT=/home/user/cvs

# Optional overrides
# TYPESAFE_MODEL=jev-latest
# PORT=8799
